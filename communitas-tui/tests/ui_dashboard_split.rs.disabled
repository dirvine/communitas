// ============================================================================
// TEST 8: Integration with existing dashboard
// ============================================================================

#[test]
fn test_dashboard_maintains_existing_functionality() {
    // Arrange
    let mut state = AppState::new();

    // Act - Existing dashboard state should still work
    state.navigation.selected_index = 1; // Projects tab

    // Assert - Navigation still works alongside split
    assert_eq!(state.navigation.selected_index, 1);
    assert_eq!(state.resizable_split.position(), 30);
}

#[test]
fn test_split_persists_across_tab_changes() {
    // Arrange
    let mut state = AppState::new();

    // Act - Change split position via drag
    state.resizable_split.start_drag(30, 25);
    state.resizable_split.update_drag(35, 25);
    state.resizable_split.end_drag();

    // Change tab
    state.navigation.selected_index = 2;

    // Assert - Split position should persist
    assert_eq!(state.resizable_split.position(), 35);
    assert_eq!(state.navigation.selected_index, 2);
}

// ============================================================================
// TEST 9: Edge cases
// ============================================================================

#[test]
fn test_split_with_very_small_terminal() {
    // Arrange
    let state = AppState::new();
    let small_area = Rect::new(0, 0, 40, 20); // Very small terminal

    // Act
    let split_position = state.resizable_split.position();
    let left_width = (small_area.width * split_position) / 100;

    // Assert - Should still calculate correctly
    assert_eq!(left_width, 12); // 30% of 40

    // Min constraint (20% of 40 = 8) is satisfied
    assert!(left_width >= 8);
}

#[test]
fn test_split_with_very_large_terminal() {
    // Arrange
    let state = AppState::new();
    let large_area = Rect::new(0, 0, 300, 100);

    // Act
    let split_position = state.resizable_split.position();
    let left_width = (large_area.width * split_position) / 100;

    // Assert
    assert_eq!(left_width, 90); // 30% of 300
}

