namespace communitas {
    /// Generate a random four-word identity from the dictionary
    ///
    /// Generates 4 random valid words from the four-word-networking dictionary
    /// to create a new user identity like "ocean-forest-moon-star".
    [Throws=ClientError]
    string generate_id_words();
};

// ============================================================================
// Error Types
// ============================================================================

[Error]
enum ClientError {
    "InitError",
    "AuthError",
    "NetworkError",
    "EntityError",
    "MessageError",
    "StorageError",
    "DocumentError",
    "PresenceError",
    "IoError",
    "NotFound",
};

// ============================================================================
// Enum Types
// ============================================================================

enum SwiftEntityType {
    "Group",
    "Channel",
    "Project",
    "Organisation",
    "Person",
};

enum SwiftPresenceStatus {
    "Online",
    "Away",
    "Busy",
    "Offline",
};

enum SwiftStorageMode {
    "FilesOnly",
    "WebOnly",
    "Both",
};

// ============================================================================
// Record Types (Data Structures)
// ============================================================================

dictionary SwiftUserProfile {
    string four_words;
    string display_name;
    string device_name;
    string device_type;
};

dictionary SwiftEntity {
    string id;
    string name;
    SwiftEntityType entity_type;
    string? description;
    string created_by;
    i64 created_at;
    sequence<string> members;
    string? parent_org_id;
};

dictionary SwiftMemberInfo {
    string four_words;
    string? display_name;
    string role;
    i64 joined_at;
};

dictionary SwiftMessage {
    string id;
    string text;
    string author;
    i64 created_at;
    string? reply_to_id;
    string entity_id;
    sequence<SwiftReaction> reactions;
};

dictionary SwiftReaction {
    string emoji;
    u32 count;
    sequence<string> users;
};

dictionary SwiftSessionInfo {
    string session_id;
    string four_words;
    string display_name;
};

dictionary SwiftVaultInfo {
    string four_words;
    string display_name;
    u64 created_at;
    u64 last_accessed;
    u64 size_bytes;
};

dictionary SwiftRecentIdentity {
    string four_words;
    string display_name;
    u64 last_used;
    boolean has_passkey;
};

dictionary SwiftPasskeyInfo {
    string credential_id;
    string device_name;
    u64 created_at;
    u64? last_used;
};

dictionary SwiftPresenceInfo {
    string four_words;
    SwiftPresenceStatus status;
    i64 last_seen;
    string? device_name;
};

dictionary SwiftContactInfo {
    string four_words;
    string? display_name;
    boolean is_favourite;
    boolean online;
    // Endpoint tracking for direct reconnection
    string? last_seen_endpoint;        // Four-word encoded IP:port
    i64? endpoint_updated_at;          // Unix timestamp millis
    u32 endpoint_success_count;
    u32 endpoint_failure_count;
};

dictionary SwiftDocumentInfo {
    string id;
    string name;
    string entity_id;
    i64 created_at;
    i64 modified_at;
    SwiftStorageMode storage_mode;
};

dictionary SwiftFileInfo {
    string path;
    string name;
    boolean is_directory;
    u64 size_bytes;
    i64 modified_at;
};

dictionary SwiftStorageStats {
    u64 total_bytes;
    u64 used_bytes;
    u32 file_count;
};

dictionary SwiftSyncState {
    string entity_id;
    u32 message_count;
    i64 last_sync_time;
    boolean is_syncing;
};

// ============================================================================
// Main Client Interface
// ============================================================================

interface CommunitasClient {
    [Throws=ClientError]
    constructor(string four_words, string display_name, string device_name, string storage_path);

    // Core methods
    SwiftUserProfile get_profile();
    boolean is_networking_active();
    string? get_connection_identity();

    // ========================================================================
    // Auth Sub-Client Methods (15 methods)
    // ========================================================================

    [Throws=ClientError]
    string auth_create_vault(string four_words, string password, string display_name);

    [Throws=ClientError]
    SwiftSessionInfo auth_login(string four_words, string password);

    [Throws=ClientError]
    void auth_logout();

    SwiftSessionInfo? auth_get_current_session();

    [Throws=ClientError]
    sequence<SwiftVaultInfo> auth_list_vaults();

    [Throws=ClientError]
    boolean auth_vault_exists(string four_words);

    [Throws=ClientError]
    void auth_delete_vault(string four_words, string password);

    [Throws=ClientError]
    SwiftPasskeyInfo auth_register_passkey(string four_words, string device_name);

    [Throws=ClientError]
    SwiftSessionInfo auth_authenticate_with_passkey(string four_words);

    [Throws=ClientError]
    boolean auth_has_passkey(string four_words);

    [Throws=ClientError]
    void auth_delete_passkey(string four_words);

    [Throws=ClientError]
    sequence<SwiftRecentIdentity> auth_get_recent_identities();

    [Throws=ClientError]
    SwiftSessionInfo? auth_try_auto_login();

    // ========================================================================
    // Entity Sub-Client Methods (10 methods)
    // ========================================================================

    [Throws=ClientError]
    SwiftEntity entity_create(string name, SwiftEntityType entity_type, string? description, string? parent_org_id);

    [Throws=ClientError]
    SwiftEntity entity_get(string entity_id);

    [Throws=ClientError]
    sequence<SwiftEntity> entity_list();

    [Throws=ClientError]
    sequence<SwiftEntity> entity_list_by_type(SwiftEntityType entity_type);

    [Throws=ClientError]
    void entity_add_member(string entity_id, string member_four_words, string role);

    [Throws=ClientError]
    void entity_remove_member(string entity_id, string member_four_words);

    [Throws=ClientError]
    sequence<SwiftMemberInfo> entity_list_members(string entity_id);

    [Throws=ClientError]
    void entity_set_parent_org(string entity_id, string org_id);

    // ========================================================================
    // Messaging Sub-Client Methods (7 methods)
    // ========================================================================

    [Throws=ClientError]
    string message_send(string entity_id, string text, string? reply_to_id);

    [Throws=ClientError]
    string message_send_direct(string recipient_four_words, string text);

    [Throws=ClientError]
    sequence<SwiftMessage> message_get_for_entity(string entity_id, u32? limit, string? before_id);

    [Throws=ClientError]
    sequence<SwiftMessage> message_get_thread(string entity_id, string parent_message_id);

    [Throws=ClientError]
    sequence<SwiftMessage> message_get_direct(string peer_four_words);

    [Throws=ClientError]
    SwiftSyncState message_get_sync_state(string entity_id);

    // ========================================================================
    // Document Sub-Client Methods (8 methods)
    // ========================================================================

    [Throws=ClientError]
    string document_create(string entity_id, string name, SwiftStorageMode storage_mode);

    [Throws=ClientError]
    SwiftDocumentInfo document_get_info(string doc_id);

    [Throws=ClientError]
    sequence<SwiftDocumentInfo> document_list(string? entity_id);

    [Throws=ClientError]
    void document_delete(string doc_id);

    [Throws=ClientError]
    void document_insert_text(string doc_id, u32 position, string text);

    [Throws=ClientError]
    void document_delete_text(string doc_id, u32 position, u32 length);

    [Throws=ClientError]
    string document_get_text(string doc_id);

    [Throws=ClientError]
    sequence<u8> document_get_crdt_update(string doc_id);

    [Throws=ClientError]
    void document_apply_crdt_update(string doc_id, sequence<u8> update);

    // ========================================================================
    // Gossip/Network Sub-Client Methods (13 methods)
    // ========================================================================

    [Throws=ClientError]
    string gossip_start(u16? port);

    [Throws=ClientError]
    void gossip_stop();

    [Throws=ClientError]
    void gossip_connect_to_peer(string four_words);

    [Throws=ClientError]
    string gossip_find_contact(string four_words);

    [Throws=ClientError]
    void gossip_add_contact(string four_words);

    [Throws=ClientError]
    sequence<SwiftContactInfo> gossip_get_contacts();

    [Throws=ClientError]
    void gossip_remove_contact(string four_words);

    [Throws=ClientError]
    void gossip_add_favourite_contact(string four_words);

    [Throws=ClientError]
    sequence<string> gossip_get_favourite_contacts();

    [Throws=ClientError]
    void gossip_join_entity(string entity_id, string entity_type);

    [Throws=ClientError]
    void gossip_leave_entity(string entity_id);

    [Throws=ClientError]
    void gossip_publish_to_entity(string entity_id, sequence<u8> message);

    [Throws=ClientError]
    void gossip_send_p2p_message(string peer_four_words, sequence<u8> message);

    // Contact endpoint tracking
    string? gossip_contact_get_endpoint(string four_words);

    [Throws=ClientError]
    void gossip_contact_update_endpoint(string four_words, string endpoint);

    [Throws=ClientError]
    void gossip_contact_record_success(string four_words, string endpoint);

    [Throws=ClientError]
    void gossip_contact_record_failure(string four_words);

    // ========================================================================
    // Presence Sub-Client Methods (5 methods)
    // ========================================================================

    [Throws=ClientError]
    void presence_start_beacons();

    [Throws=ClientError]
    void presence_stop_beacons();

    [Throws=ClientError]
    SwiftPresenceStatus presence_get_status(string four_words);

    [Throws=ClientError]
    boolean presence_is_online(string four_words);

    [Throws=ClientError]
    sequence<SwiftPresenceInfo> presence_get_online_in_entity(string entity_id);
};
