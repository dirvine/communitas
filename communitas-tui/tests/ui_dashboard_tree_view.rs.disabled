#[test]
fn test_tree_view_handles_very_deep_hierarchy() {
    // Arrange - Create deeply nested structure
    let level_3 = TreeNode::new("l3", "Level 3", String::new());
    let level_2 = TreeNode::new("l2", "Level 2", String::new()).with_child(level_3);
    let level_1 = TreeNode::new("l1", "Level 1", String::new()).with_child(level_2);

    // Assert - Should support arbitrary nesting
    assert!(level_1.has_children());
    assert_eq!(level_1.children[0].children.len(), 1);
}

#[test]
fn test_tree_view_handles_long_node_labels() {
    // Arrange
    let long_label = "A".repeat(100);
    let node = TreeNode::new("test", &long_label, String::new());

    // Assert - Long labels should be handled (truncated in rendering)
    assert_eq!(node.label.len(), 100);
    // Rendering should truncate to fit panel width
}

