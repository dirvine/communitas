/// Test: start_screen_share - Happy Path
///
/// **Acceptance Criteria**:
/// - Screen share track is added to the call
/// - ScreenShareStarted event is emitted
/// - Peer is notified via signaling
#[tokio::test]
async fn test_start_screen_share_success() {
    let fixture = WebRtcTestFixture::new();
    fixture.initialize().expect("fixture init");

    let target = "river-mountain-cloud-sun";
    let call_id = fixture.webrtc_service.initiate_call(
        target.to_string(),
        constraints::video_call(),
    ).expect("call ID");

    fixture.webrtc_service.accept_call(call_id.clone())
        .expect("accept call");

    // Start screen sharing
    let result = fixture.webrtc_service.start_screen_share(call_id.clone());

    assert!(result.is_ok(), "start_screen_share should succeed");

    // Verify screen sharing is active
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(call.is_screen_sharing, "screen sharing should be active");

    fixture.cleanup().expect("cleanup");
}

