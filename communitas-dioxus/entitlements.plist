<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ═══════════════════════════════════════════════════════════════════════
         Communitas macOS Entitlements
         Required for hardened runtime with notarization
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Allow the app to make network connections (client) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow the app to listen for incoming network connections (P2P) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Allow access to user-selected files (file picker) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow access to Downloads folder (common save location) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Allow access to camera (for video calls) -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- Allow access to microphone (for voice/video calls) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Allow JIT compilation (required for WebView JavaScript) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required for WebView) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Disable library validation (required for WebView plugins) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
