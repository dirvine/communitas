//! Integration tests for mouse handler in App
//!
//! Tests the integration of mouse event handling into the main TUI application,
//! including hover states, drag operations, context menus, and scroll handling.

use communitas_tui::components::{
    ComponentArea, ContextMenu, DoubleClickDetector, DragState, EnhancedMouseEvent, HoverState,
    MenuContext, ScrollState, classify_mouse_event,
};
use crossterm::event::{MouseButton, MouseEvent, MouseEventKind};

// Mock AppState with mouse-related state
#[derive(Debug, Clone)]
struct AppMouseState {
    // Component areas for hit detection
    message_list_area: ComponentArea,
    sidebar_area: ComponentArea,
    input_area: ComponentArea,

    // Mouse interaction state
    hover_state: HoverState,
    drag_state: DragState,
    double_click_detector: DoubleClickDetector,
    scroll_state: ScrollState,

    // Context menu
    context_menu: ContextMenu,

    // Track last action for testing
    last_action: Option<String>,
}

impl AppMouseState {
    fn new() -> Self {
        Self {
            // Define component areas (80x24 terminal assumed)
            message_list_area: ComponentArea::new(20, 5, 55, 15), // Center area for messages
            sidebar_area: ComponentArea::new(0, 0, 20, 24),       // Left sidebar
            input_area: ComponentArea::new(20, 20, 55, 4),        // Bottom input area

            hover_state: HoverState::new(),
            drag_state: DragState::new(),
            double_click_detector: DoubleClickDetector::new(500, 2),
            scroll_state: ScrollState::new(100, 20), // 100 lines of content, 20 visible

            context_menu: ContextMenu::new(),

            last_action: None,
        }
    }

    /// Handle mouse event and update state
    fn handle_mouse_event(&mut self, mouse: MouseEvent) {
        let col = mouse.column;
        let row = mouse.row;

        // Classify the event
        let enhanced_event = classify_mouse_event(mouse, &self.drag_state);

        if let Some(event) = enhanced_event {
            match event {
                EnhancedMouseEvent::Hover { x, y } => {
                    // Check if hovering over a component
                    if self.message_list_area.contains(x, y) {
                        if !self.hover_state.hovered {
                            self.hover_state.on_mouse_enter(x, y);
                        }
                    } else if self.hover_state.hovered {
                        self.hover_state.on_mouse_exit();
                    }
                }
                EnhancedMouseEvent::RightClick { x, y } => {
                    // Show context menu if in message area
                    if self.message_list_area.contains(x, y) {
                        self.context_menu.show_at(
                            x,
                            y,
                            MenuContext::Message {
                                is_own: true,
                                can_edit: true,
                            },
                        );
                        // Adjust position to fit screen (80x24)
                        self.context_menu.adjust_position_for_screen(80, 24);
                    }
                }
                EnhancedMouseEvent::LeftClick { x, y } => {
                    // Handle double-click detection
                    let is_double_click = self.double_click_detector.register_click(x, y);
                    if is_double_click {
                        self.last_action = Some(format!("double_click_{}_{}", x, y));
                    } else {
                        self.last_action = Some(format!("single_click_{}_{}", x, y));
                    }

                    // Handle context menu selection
                    if self.context_menu.visible {
                        if let Some(action) = self.context_menu.handle_mouse(mouse) {
                            self.last_action = Some(format!("menu_action_{:?}", action));
                        }
                    }
                }
                EnhancedMouseEvent::DragStart { x, y } => {
                    self.drag_state.start_drag(x, y);
                    self.last_action = Some(format!("drag_start_{}_{}", x, y));
                }
                EnhancedMouseEvent::Dragging {
                    x,
                    y,
                    start_x: _,
                    start_y: _,
                } => {
                    self.drag_state.update_drag(x, y);
                }
                EnhancedMouseEvent::MouseUp { x, y, button } => {
                    if button == MouseButton::Left && self.drag_state.is_dragging() {
                        self.drag_state.end_drag();
                        self.last_action = Some(format!("drag_end_{}_{}", x, y));
                    }
                }
                EnhancedMouseEvent::ScrollUp { x, y } => {
                    // Scroll if in message area
                    if self.message_list_area.contains(x, y) {
                        self.scroll_state.scroll_by(-3); // Scroll up 3 lines
                        self.last_action = Some("scroll_up".to_string());
                    }
                }
                EnhancedMouseEvent::ScrollDown { x, y } => {
                    // Scroll if in message area
                    if self.message_list_area.contains(x, y) {
                        self.scroll_state.scroll_by(3); // Scroll down 3 lines
                        self.last_action = Some("scroll_down".to_string());
                    }
                }
                _ => {}
            }
        }
    }

    /// Helper: Simulate mouse event
    fn simulate_mouse_event(&mut self, kind: MouseEventKind, column: u16, row: u16) {
        let event = MouseEvent {
            kind,
            column,
            row,
            modifiers: crossterm::event::KeyModifiers::empty(),
        };
        self.handle_mouse_event(event);
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_hover_state_enters_when_mouse_moves_to_message_area() {
        let mut state = AppMouseState::new();
        assert!(!state.hover_state.hovered);

        // Move mouse into message area (center: 20-75, 5-20)
        state.simulate_mouse_event(MouseEventKind::Moved, 40, 10);

        assert!(state.hover_state.hovered);
        assert_eq!(state.hover_state.position(), Some((40, 10)));
    }

    #[test]
    fn test_hover_state_exits_when_mouse_leaves_message_area() {
        let mut state = AppMouseState::new();

        // Enter message area
        state.simulate_mouse_event(MouseEventKind::Moved, 40, 10);
        assert!(state.hover_state.hovered);

        // Leave message area (move to sidebar)
        state.simulate_mouse_event(MouseEventKind::Moved, 10, 10);
        assert!(!state.hover_state.hovered);
    }

    #[test]
    fn test_right_click_in_message_area_shows_context_menu() {
        let mut state = AppMouseState::new();
        assert!(!state.context_menu.visible);

        // Right-click in message area
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Right), 40, 10);

        assert!(state.context_menu.visible);
        assert_eq!(state.context_menu.position.0, 40);
        assert_eq!(state.context_menu.position.1, 10);
    }

    #[test]
    fn test_right_click_outside_message_area_does_not_show_menu() {
        let mut state = AppMouseState::new();

        // Right-click in sidebar (outside message area)
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Right), 10, 10);

        assert!(!state.context_menu.visible);
    }

    #[test]
    fn test_context_menu_adjusts_position_near_screen_edge() {
        let mut state = AppMouseState::new();

        // Right-click near right edge of screen
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Right), 70, 10);

        assert!(state.context_menu.visible);
        // Menu should be adjusted to fit within 80 column width
        let bounds = state.context_menu.calculate_bounds();
        assert!(state.context_menu.position.0 + bounds.width <= 80);
    }

    #[test]
    fn test_double_click_detection() {
        let mut state = AppMouseState::new();

        // First click
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Left), 40, 10);
        assert_eq!(state.last_action, Some("single_click_40_10".to_string()));

        // Second click at same position (should be detected as double-click)
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Left), 40, 10);
        assert_eq!(state.last_action, Some("double_click_40_10".to_string()));
    }

    #[test]
    fn test_drag_operation_lifecycle() {
        let mut state = AppMouseState::new();

        // Start drag
        state.simulate_mouse_event(MouseEventKind::Drag(MouseButton::Left), 40, 10);
        assert!(state.drag_state.is_dragging());
        assert_eq!(state.last_action, Some("drag_start_40_10".to_string()));

        // Continue dragging
        state.simulate_mouse_event(MouseEventKind::Drag(MouseButton::Left), 45, 12);
        assert!(state.drag_state.is_dragging());
        assert_eq!(state.drag_state.get_drag_delta(), Some((5, 2)));

        // End drag (mouse up)
        state.simulate_mouse_event(MouseEventKind::Up(MouseButton::Left), 45, 12);
        assert!(!state.drag_state.is_dragging());
        assert_eq!(state.last_action, Some("drag_end_45_12".to_string()));
    }

    #[test]
    fn test_scroll_up_in_message_area() {
        let mut state = AppMouseState::new();
        let initial_offset = state.scroll_state.scroll_offset;

        // Scroll up in message area
        state.simulate_mouse_event(MouseEventKind::ScrollUp, 40, 10);

        assert_eq!(state.last_action, Some("scroll_up".to_string()));
        // Should not scroll above 0
        assert_eq!(state.scroll_state.scroll_offset, initial_offset); // Was 0, stays 0
    }

    #[test]
    fn test_scroll_down_in_message_area() {
        let mut state = AppMouseState::new();
        assert_eq!(state.scroll_state.scroll_offset, 0);

        // Scroll down in message area
        state.simulate_mouse_event(MouseEventKind::ScrollDown, 40, 10);

        assert_eq!(state.last_action, Some("scroll_down".to_string()));
        assert_eq!(state.scroll_state.scroll_offset, 3); // Scrolled down 3 lines
    }

    #[test]
    fn test_scroll_ignores_events_outside_message_area() {
        let mut state = AppMouseState::new();
        assert_eq!(state.scroll_state.scroll_offset, 0);

        // Try to scroll in sidebar (outside message area)
        state.simulate_mouse_event(MouseEventKind::ScrollDown, 10, 10);

        assert!(state.last_action.is_none()); // No action recorded
        assert_eq!(state.scroll_state.scroll_offset, 0); // No scroll occurred
    }

    #[test]
    fn test_context_menu_item_selection() {
        let mut state = AppMouseState::new();

        // Show context menu
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Right), 40, 10);
        assert!(state.context_menu.visible);

        // Click on first menu item (Reply)
        let menu_x = state.context_menu.position.0;
        let menu_y = state.context_menu.position.1;
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Left), menu_x, menu_y);

        // Should have executed menu action and hidden menu
        assert!(state.last_action.is_some());
        assert!(state.last_action.as_ref().unwrap().contains("menu_action"));
        assert!(!state.context_menu.visible);
    }

    #[test]
    fn test_multiple_hover_transitions() {
        let mut state = AppMouseState::new();

        // Hover over message area
        state.simulate_mouse_event(MouseEventKind::Moved, 40, 10);
        assert!(state.hover_state.hovered);

        // Move to sidebar
        state.simulate_mouse_event(MouseEventKind::Moved, 10, 10);
        assert!(!state.hover_state.hovered);

        // Move back to message area
        state.simulate_mouse_event(MouseEventKind::Moved, 50, 12);
        assert!(state.hover_state.hovered);
        assert_eq!(state.hover_state.position(), Some((50, 12)));
    }

    #[test]
    fn test_component_area_boundaries() {
        let state = AppMouseState::new();

        // Test message list area boundaries (20, 5, 55, 15) -> (20-75, 5-20)
        assert!(state.message_list_area.contains(20, 5)); // Top-left corner
        assert!(state.message_list_area.contains(74, 19)); // Bottom-right (exclusive)
        assert!(!state.message_list_area.contains(19, 5)); // Just outside left
        assert!(!state.message_list_area.contains(75, 5)); // Just outside right
        assert!(!state.message_list_area.contains(40, 4)); // Just above
        assert!(!state.message_list_area.contains(40, 20)); // Just below

        // Test sidebar area boundaries (0, 0, 20, 24) -> (0-20, 0-24)
        assert!(state.sidebar_area.contains(0, 0)); // Top-left corner
        assert!(state.sidebar_area.contains(19, 23)); // Bottom-right (exclusive)
        assert!(!state.sidebar_area.contains(20, 0)); // Just outside right
    }

    #[test]
    fn test_drag_only_in_appropriate_areas() {
        let mut state = AppMouseState::new();

        // Start drag in message area
        state.simulate_mouse_event(MouseEventKind::Drag(MouseButton::Left), 40, 10);
        assert!(state.drag_state.is_dragging());

        // Reset for next test
        state.drag_state.reset();

        // Start drag in input area should also work
        state.simulate_mouse_event(MouseEventKind::Drag(MouseButton::Left), 40, 21);
        assert!(state.drag_state.is_dragging());
    }

    #[test]
    fn test_scroll_state_respects_content_bounds() {
        let mut state = AppMouseState::new();
        // Content: 100 lines, Viewport: 20 lines, Max offset: 80

        // Scroll down multiple times
        for _ in 0..30 {
            state.simulate_mouse_event(MouseEventKind::ScrollDown, 40, 10);
        }

        // Should clamp at max offset (80)
        assert_eq!(state.scroll_state.scroll_offset, 80);
        assert!(state.scroll_state.is_at_bottom());

        // Try to scroll up from bottom
        state.simulate_mouse_event(MouseEventKind::ScrollUp, 40, 10);
        assert_eq!(state.scroll_state.scroll_offset, 77); // 80 - 3
        assert!(!state.scroll_state.is_at_bottom());
    }

    #[test]
    fn test_hover_state_persists_within_area() {
        let mut state = AppMouseState::new();

        // Enter message area
        state.simulate_mouse_event(MouseEventKind::Moved, 40, 10);
        assert!(state.hover_state.hovered);

        // Move within message area
        state.simulate_mouse_event(MouseEventKind::Moved, 45, 12);
        assert!(state.hover_state.hovered);
        assert_eq!(state.hover_state.position(), Some((40, 10))); // Position set on enter, not updated on move
    }

    #[test]
    fn test_context_menu_closes_on_click_outside() {
        let mut state = AppMouseState::new();

        // Show context menu
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Right), 40, 10);
        assert!(state.context_menu.visible);

        // Click outside menu area (in sidebar)
        state.simulate_mouse_event(MouseEventKind::Down(MouseButton::Left), 10, 10);

        assert!(!state.context_menu.visible);
    }
}
