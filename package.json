{
  "name": "communitas",
  "version": "0.1.17",
  "description": "A decentralized P2P chat and collaboration platform built on Saorsa Core",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx src/server/routes.ts",
    "dev:browser": "vite --port 1420 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "npm run build && cd communitas-desktop && cargo tauri dev",
    "tauri:build": "npm run build && cd communitas-desktop && cargo tauri build",
    "test": "NODE_OPTIONS=--max-old-space-size=10240 CI=true vitest --run --reporter=dot",
    "test:components": "NODE_OPTIONS=--max-old-space-size=10240 CI=true vitest run --reporter=dot",
    "test:services": "NODE_OPTIONS=--max-old-space-size=10240 CI=true vitest run --reporter=dot",
    "test:utils": "NODE_OPTIONS=--max-old-space-size=10240 CI=true vitest run --reporter=dot",
    "test:ci": "NODE_OPTIONS=--max-old-space-size=10240 CI=true vitest run --reporter=dot --pool=threads --poolOptions.threads.maxThreads=1 --poolOptions.threads.minThreads=1",
    "test:fast": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --reporter=dot src/services/__tests__/featureFlags.test.ts src/utils/__tests__/identity.test.ts src/services/storage/__tests__/markdownPublisher.test.ts",
    "test:run": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --reporter=dot src/services/__tests__/featureFlags.test.ts src/utils/__tests__/identity.test.ts",
    "test:coverage:smoke": "NODE_OPTIONS=--max-old-space-size=10240 CI=true vitest run --coverage --reporter=dot src/services/__tests__/featureFlags.test.ts src/utils/__tests__/identity.test.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=10240 CI=true vitest run --coverage --reporter=dot",
    "test:coverage:slow": "RUN_SLOW=1 NODE_OPTIONS=--max-old-space-size=8192 vitest run --coverage --reporter=dot",
    "offline:start": "bash scripts/offline-start.sh",
    "offline:test": "bash scripts/offline-test.sh",
    "offline:stop": "bash scripts/offline-stop.sh",
    "offline:all:once": "bash -lc 'npm run offline:start && npm run offline:test; npm run offline:stop'",
    "offline:all": "bash -lc 'npm run offline:start && npm run offline:test'",
    "playwright:install": "npx playwright install --with-deps",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:chrome": "playwright test --project=chromium --headed --channel=chrome",
    "test:playwright:ui:chrome": "playwright test --ui --project=chromium --channel=chrome",
    "playwright:open:chrome": "playwright open http://localhost:1420 --channel=chrome"
  },
  "dependencies": {
    "@automerge/automerge": "^2.0.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/lab": "^7.0.0-alpha.58",
    "@mui/material": "^7.3.1",
    "@octokit/rest": "^22.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "async-mutex": "^0.5.0",
    "chrome-devtools-mcp": "^0.2.7",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.0.5",
    "events": "^3.3.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.12",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^3.0.3",
    "marked": "^14.1.3",
    "monaco-editor": "^0.50.0",
    "notistack": "^3.0.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.26.2",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "text-encoding-polyfill": "^0.6.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "validator": "^13.12.0",
    "wasm-reed-solomon-erasure": "^0.2.2",
    "y-indexeddb": "^9.0.12",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.21",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.18.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/validator": "^13.12.2",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^24.0.0",
    "playwright": "^1.55.0",
    "typescript": "^5.6.3",
    "vite": "^5.0.8",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^1.6.1"
  },
  "overrides": {
    "prismjs": "^1.30.0"
  }
}
