    let sv = doc.transact().state_vector().encode_v1();
    assert!(!sv.is_empty());

    Ok(())
}

#[tokio::test]
async fn test_crdt_diff_sync() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let org = create_organization(&crdt, "Diff Sync Test", None, "user-123").await?;

    let doc_id = format!("org:{}", org.id);

    // Get initial state vector
    let doc = crdt.load_document(&doc_id).await?;
    let sv1 = doc.transact().state_vector();

    // Make some changes via update
    update_organization(&crdt, &org.id, Some("Updated Name"), None).await?;

    // Get diff from initial state
    let doc_updated = crdt.load_document(&doc_id).await?;
    let diff = doc_updated.transact().encode_state_as_update_v1(&sv1);
    assert!(!diff.is_empty()); // Should have changes

    // Apply diff to another doc
    let doc2 = Doc::new();
    {
        let mut txn = doc2.transact_mut();
        txn.apply_update(yrs::Update::decode_v1(&diff)?);
    }

    Ok(())
}

#[tokio::test]
async fn test_multiple_organizations() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;
    let entity_service = EntityService::new(crdt.clone());

    let user_id = "user-123";
    let mut org_ids = Vec::new();

    // Create multiple organizations
    for i in 1..=5 {
        let org = create_organization(
            &crdt,
            &format!("Org {}", i),
            Some(format!("Description {}", i)),
            user_id,
        )
        .await?;

        // Add creator as member
        entity_service
            .add_member(EntityType::Organisation, &org.id, user_id, "owner")
            .await?;

        org_ids.push(org.id);
    }

    // Verify user is member of all 5 orgs
    let mut membership_count = 0;
    for org_id in &org_ids {
        let members = entity_service
            .list_members(EntityType::Organisation, org_id)
            .await?;
        if members.iter().any(|m| m.member_id == user_id && !m.deleted) {
            membership_count += 1;
        }
    }

    assert_eq!(membership_count, 5);

    Ok(())
}

#[tokio::test]
async fn test_organization_metadata_in_crdt() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let org = create_organization(
        &crdt,
        "Metadata Test",
        Some("Test description".to_string()),
        "user-123",
    )
    .await?;

    // Get update and verify it contains data
    let doc_id = format!("org:{}", org.id);
    let doc = crdt.load_document(&doc_id).await?;
    let update = doc
        .transact()
        .encode_state_as_update_v1(&yrs::StateVector::default());
    assert!(!update.is_empty());

    // CRDT document should be loadable
    let sv = doc.transact().state_vector().encode_v1();
    assert!(!sv.is_empty());

    // Verify metadata is correct
    let loaded_org = OrganizationDocument::from_document(&doc)?;
    assert_eq!(loaded_org.name, "Metadata Test");
    assert_eq!(loaded_org.description, Some("Test description".to_string()));

    Ok(())
}

#[tokio::test]
async fn test_concurrent_member_operations() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;
    let entity_service = EntityService::new(crdt.clone());

    let org = create_organization(&crdt, "Concurrent Test", None, "user-123").await?;

    // Add creator first
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-123", "owner")
        .await?;

    // Add multiple members concurrently
    let handles: Vec<_> = (1..=10)
        .map(|i| {
            let entity_service = &entity_service;
            let org_id = org.id.clone();
            async move {
                entity_service
                    .add_member(
                        EntityType::Organisation,
                        &org_id,
                        &format!("user-{}", i),
                        "member",
                    )
                    .await
            }
        })
        .collect();

    // Wait for all to complete
    for handle in handles {
        handle.await?;
    }

    // Verify all members were added (creator + 10 concurrent adds)
    let members = entity_service
        .list_members(EntityType::Organisation, &org.id)
        .await?;
    let active_members = members.iter().filter(|m| !m.deleted).count();
    assert_eq!(active_members, 11);

    Ok(())
}
