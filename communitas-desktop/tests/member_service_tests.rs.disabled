#[tokio::test]
async fn test_set_website_root() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(&crdt, "Website Test", None).await?;

    // Initially no website root
    let initial = get_member(&crdt, &member.id).await?.unwrap();
    assert!(initial.website_root.is_none());

    // Set website root
    let root_hash = "QmWebsiteHash123456789";
    set_website_root(&crdt, &member.id, root_hash).await?;

    // Verify it was set
    let updated = get_member(&crdt, &member.id).await?.unwrap();
    assert_eq!(updated.website_root, Some(root_hash.to_string()));

    Ok(())
}

#[tokio::test]
async fn test_update_website_root() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(&crdt, "Website Update", None).await?;

    // Set initial website root
    set_website_root(&crdt, &member.id, "QmOldHash").await?;

    let initial = get_member(&crdt, &member.id).await?.unwrap();
    assert_eq!(initial.website_root, Some("QmOldHash".to_string()));

    // Update to new website root
    set_website_root(&crdt, &member.id, "QmNewHash").await?;

    let updated = get_member(&crdt, &member.id).await?.unwrap();
    assert_eq!(updated.website_root, Some("QmNewHash".to_string()));

    Ok(())
}

#[tokio::test]
async fn test_delete_member() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(&crdt, "Delete Test", None).await?;

    // Verify it exists
    assert!(get_member(&crdt, &member.id).await?.is_some());

    // Delete it by removing from database
    let doc_id = format!("member:{}", member.id);
    crdt.delete_document(&doc_id).await?;

    // Verify it's gone
    assert!(get_member(&crdt, &member.id).await?.is_none());

    Ok(())
}

#[tokio::test]
async fn test_crdt_update_sync() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(&crdt, "CRDT Test", Some("crdt@example.com".to_string())).await?;

    // Get full update
    let doc_id = format!("member:{}", member.id);
    let doc = crdt.load_document(&doc_id).await?;
    let update = doc
        .transact()
        .encode_state_as_update_v1(&yrs::StateVector::default());
    assert!(!update.is_empty());

    // Apply update (simulating sync from another peer)
    let doc2 = Doc::new();
    {
        let mut txn = doc2.transact_mut();
        txn.apply_update(yrs::Update::decode_v1(&update)?);
    }

    // Should still work
    let retrieved = MemberDocument::from_document(&doc2)?;
    assert_eq!(retrieved.id, member.id);
    assert_eq!(retrieved.display_name, member.display_name);

    Ok(())
}

#[tokio::test]
async fn test_crdt_state_vector() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(&crdt, "State Vector Test", None).await?;

    // Get state vector
    let doc_id = format!("member:{}", member.id);
    let doc = crdt.load_document(&doc_id).await?;
    let sv = doc.transact().state_vector().encode_v1();
    assert!(!sv.is_empty());

    Ok(())
}

#[tokio::test]
async fn test_crdt_diff_sync() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(&crdt, "Diff Sync Test", None).await?;

    let doc_id = format!("member:{}", member.id);

    // Get initial state vector
    let doc = crdt.load_document(&doc_id).await?;
    let sv1 = doc.transact().state_vector();

    // Make some changes via update
    update_member(&crdt, &member.id, Some("Updated Name"), None, None, None).await?;

    // Get diff from initial state
    let doc_updated = crdt.load_document(&doc_id).await?;
    let diff = doc_updated.transact().encode_state_as_update_v1(&sv1);
    assert!(!diff.is_empty()); // Should have changes

    // Apply diff to another doc
    let doc2 = Doc::new();
    {
        let mut txn = doc2.transact_mut();
        txn.apply_update(yrs::Update::decode_v1(&diff)?);
    }

    Ok(())
}

#[tokio::test]
async fn test_member_metadata_in_crdt() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(
        &crdt,
        "Metadata Test",
        Some("metadata@example.com".to_string()),
    )
    .await?;

    // Get update and verify it contains data
    let doc_id = format!("member:{}", member.id);
    let doc = crdt.load_document(&doc_id).await?;
    let update = doc
        .transact()
        .encode_state_as_update_v1(&yrs::StateVector::default());
    assert!(!update.is_empty());

    // CRDT document should be loadable
    let sv = doc.transact().state_vector().encode_v1();
    assert!(!sv.is_empty());

    // Verify metadata is correct
    let loaded_member = MemberDocument::from_document(&doc)?;
    assert_eq!(loaded_member.display_name, "Metadata Test");
    assert_eq!(
        loaded_member.email,
        Some("metadata@example.com".to_string())
    );

    Ok(())
}

#[tokio::test]
async fn test_personal_disk_creation() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(&crdt, "Disk Test", None).await?;

    // Verify personal disk was created
    assert!(!member.personal_disk_id.is_empty());

    // Disk ID should be unique per member
    let member2 = create_member(&crdt, "Disk Test 2", None).await?;
    assert_ne!(member.personal_disk_id, member2.personal_disk_id);

    Ok(())
}

#[tokio::test]
async fn test_multiple_members() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    // Create multiple members
    let mut created_ids = Vec::new();
    let mut created_four_words = Vec::new();

    for i in 1..=5 {
        let member = create_member(
            &crdt,
            &format!("User {}", i),
            Some(format!("user{}@example.com", i)),
        )
        .await?;

        created_ids.push(member.id.clone());
        created_four_words.push(member.four_word_identity.clone());
    }

    // All should have unique IDs
    let unique_ids: std::collections::HashSet<_> = created_ids.iter().collect();
    assert_eq!(unique_ids.len(), 5);

    // All should have unique four-word identities
    let unique_four_words: std::collections::HashSet<_> = created_four_words.iter().collect();
    assert_eq!(unique_four_words.len(), 5);

    // All should be retrievable
    for id in created_ids {
        let member = get_member(&crdt, &id).await?;
        assert!(member.is_some());
    }

    Ok(())
}

#[tokio::test]
async fn test_concurrent_member_creation() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    // Create multiple members concurrently
    let handles: Vec<_> = (1..=10)
        .map(|i| {
            let crdt = &crdt;
            async move { create_member(crdt, &format!("User {}", i), None).await }
        })
        .collect();

    // Wait for all to complete
    let mut members = Vec::new();
    for handle in handles {
        members.push(handle.await?);
    }

    // Verify all were created with unique IDs and four-word identities
    assert_eq!(members.len(), 10);

    let unique_ids: std::collections::HashSet<_> = members.iter().map(|m| &m.id).collect();
    assert_eq!(unique_ids.len(), 10);

    let unique_four_words: std::collections::HashSet<_> =
        members.iter().map(|m| &m.four_word_identity).collect();
    assert_eq!(unique_four_words.len(), 10);

    Ok(())
}

#[tokio::test]
async fn test_member_profile_completeness() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(
        &crdt,
        "Complete Profile",
        Some("complete@example.com".to_string()),
    )
    .await?;

    // Set all optional fields
    update_member(
        &crdt,
        &member.id,
        None,
        None,
        Some("https://example.com/avatar.jpg".to_string()),
        Some("Full-stack developer with 10 years of experience".to_string()),
    )
    .await?;

    set_website_root(&crdt, &member.id, "QmWebsiteRoot").await?;

    // Retrieve and verify all fields are set
    let complete = get_member(&crdt, &member.id).await?.unwrap();

    assert_eq!(complete.display_name, "Complete Profile");
    assert_eq!(complete.email, Some("complete@example.com".to_string()));
    assert_eq!(
        complete.avatar_url,
        Some("https://example.com/avatar.jpg".to_string())
    );
    assert_eq!(
        complete.bio,
        Some("Full-stack developer with 10 years of experience".to_string())
    );
    assert_eq!(complete.website_root, Some("QmWebsiteRoot".to_string()));
    assert!(!complete.four_word_identity.is_empty());
    assert!(!complete.personal_disk_id.is_empty());

    Ok(())
}

#[tokio::test]
async fn test_four_word_identity_uniqueness() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    // Create many members to test uniqueness
    let mut four_word_identities = std::collections::HashSet::new();

    for i in 1..=20 {
        let member = create_member(&crdt, &format!("User {}", i), None).await?;

        // Four-word identity should be unique
        assert!(
            four_word_identities.insert(member.four_word_identity.clone()),
            "Duplicate four-word identity generated: {}",
            member.four_word_identity
        );
    }

    assert_eq!(four_word_identities.len(), 20);

    Ok(())
}
