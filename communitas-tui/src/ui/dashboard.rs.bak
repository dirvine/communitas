use crate::state::AppState;
use ratatui::{
    Frame,
    layout::{Alignment, Constraint, Direction, Layout, Rect},
    style::{Color, Modifier, Style},
    text::{Line, Span},
    widgets::{Block, Borders, Paragraph, Tabs},
};

/// Render main dashboard with modern tabbed navigation and resizable split layout
pub fn render(f: &mut Frame, area: Rect, state: &AppState) {
    let block = Block::default()
        .title(format!("Communitas TUI v{}", env!("CARGO_PKG_VERSION")))
        .borders(Borders::ALL)
        .border_style(Style::default().fg(Color::Cyan));

    // Split into tabs, content, and instructions
    let chunks = Layout::default()
        .direction(Direction::Vertical)
        .margin(2)
        .constraints([
            Constraint::Length(3), // Tabs
            Constraint::Min(10),   // Content (will be split left/right)
            Constraint::Length(8), // Instructions
        ])
        .split(block.inner(area));

    f.render_widget(block, area);

    // Render tabs manually
    let tab_titles = vec![
        "🏢 Organizations",
        "📋 Projects",
        "👥 Groups",
        "👤 Contacts",
        "🌐 Network",
        "❓ Help",
    ];

    let tabs = Tabs::new(tab_titles)
        .block(Block::default().borders(Borders::BOTTOM))
        .select(state.navigation.selected_index)
        .style(Style::default().fg(Color::White))
        .highlight_style(
            Style::default()
                .fg(Color::Cyan)
                .add_modifier(Modifier::BOLD | Modifier::UNDERLINED),
        );

    f.render_widget(tabs, chunks[0]);

    // Calculate split layout for content area
    let content_area = chunks[1];
    let split_position = state.resizable_split.position();
    let left_width = (content_area.width * split_position) / 100;

    // Create left panel, divider, and right panel
    let left_panel = Rect::new(
        content_area.x,
        content_area.y,
        left_width.saturating_sub(1), // Leave room for divider
        content_area.height,
    );

    let divider = Rect::new(
        content_area.x + left_width.saturating_sub(1),
        content_area.y,
        1,
        content_area.height,
    );

    let right_panel = Rect::new(
        content_area.x + left_width,
        content_area.y,
        content_area.width.saturating_sub(left_width),
        content_area.height,
    );

    // Render left panel (navigation/tree view placeholder)
    render_left_panel(f, left_panel, state);

    // Render divider
    render_divider(f, divider, state);

    // Render right panel (current tab content)
    render_tab_content(f, right_panel, state, state.navigation.selected_index);

    // Instructions
    let instructions = Paragraph::new(vec![
        Line::from(""),
        Line::from(vec![Span::styled(
            "Tab Navigation",
            Style::default()
                .fg(Color::Cyan)
                .add_modifier(Modifier::BOLD),
        )]),
        Line::from(vec![
            Span::styled(
                "←→",
                Style::default()
                    .fg(Color::Green)
                    .add_modifier(Modifier::BOLD),
            ),
            Span::raw(" or "),
            Span::styled(
                "h/l",
                Style::default()
                    .fg(Color::Green)
                    .add_modifier(Modifier::BOLD),
            ),
            Span::raw(": Switch tabs"),
        ]),
        Line::from(vec![
            Span::styled(
                "Enter",
                Style::default()
                    .fg(Color::Green)
                    .add_modifier(Modifier::BOLD),
            ),
            Span::raw(": Open tab / Create entity"),
        ]),
        Line::from(vec![
            Span::styled(
                "Tab",
                Style::default()
                    .fg(Color::Green)
                    .add_modifier(Modifier::BOLD),
            ),
            Span::raw("/"),
            Span::styled(
                "Shift+Tab",
                Style::default()
                    .fg(Color::Green)
                    .add_modifier(Modifier::BOLD),
            ),
            Span::raw(": Navigate tabs"),
        ]),
        Line::from(""),
        Line::from(vec![Span::styled(
            "Global",
            Style::default()
                .fg(Color::Cyan)
                .add_modifier(Modifier::BOLD),
        )]),
        Line::from(vec![
            Span::styled(
                "i",
                Style::default()
                    .fg(Color::Green)
                    .add_modifier(Modifier::BOLD),
            ),
            Span::raw(": Initialize identity"),
        ]),
        Line::from(vec![
            Span::styled(
                "q",
                Style::default()
                    .fg(Color::Green)
                    .add_modifier(Modifier::BOLD),
            ),
            Span::raw(": Quit application"),
        ]),
    ])
    .alignment(Alignment::Left);

    f.render_widget(instructions, chunks[2]);
}

/// Render content for the selected tab
fn render_tab_content(f: &mut Frame, area: Rect, state: &AppState, tab_index: usize) {
    match tab_index {
        0 => render_organizations_tab(f, area, state),
        1 => render_projects_tab(f, area, state),
        2 => render_groups_tab(f, area, state),
        3 => render_contacts_tab(f, area, state),
        4 => render_network_tab(f, area, state),
        5 => render_help_tab(f, area, state),
        _ => render_empty_tab(f, area, "Unknown tab"),
    }
}

/// Render organizations tab content
fn render_organizations_tab(f: &mut Frame, area: Rect, state: &AppState) {
    if state.identity.is_none() {
        render_empty_tab(f, area, "Please initialize identity first (press 'i')");
        return;
    }

    let title = Paragraph::new(vec![
        Line::from(Span::styled(
            "🏢 Organizations",
            Style::default()
                .fg(Color::Yellow)
                .add_modifier(Modifier::BOLD),
        )),
        Line::from(""),
        Line::from("Create and manage organizations"),
        Line::from(""),
        Line::from(Span::styled(
            "Press 'n' to create a new organization",
            Style::default().fg(Color::Green),
        )),
        Line::from(Span::styled(
            "Press 'Enter' to select an organization",
            Style::default().fg(Color::Green),
        )),
    ])
    .alignment(Alignment::Center);

    f.render_widget(title, area);
}

