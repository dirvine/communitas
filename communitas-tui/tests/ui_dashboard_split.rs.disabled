// ============================================================================
// TEST 11: Keyboard shortcuts
// ============================================================================

#[test]
fn test_keyboard_reset_split_to_default() {
    // Arrange
    let mut state = AppState::new();

    // Act - Modify split position
    state.resizable_split.start_drag(30, 25);
    state.resizable_split.update_drag(45, 25);
    state.resizable_split.end_drag();
    assert_eq!(state.resizable_split.position(), 45);

    // Act - Reset via keyboard shortcut (Ctrl+\)
    // In actual app, this would be triggered by key event handler
    state.resizable_split.reset_position();

    // Assert - Should return to default (30%)
    assert_eq!(state.resizable_split.position(), 30);
}

#[test]
fn test_reset_from_minimum_position() {
    // Arrange
    let mut state = AppState::new();

    // Act - Set to minimum
    state.resizable_split.start_drag(30, 25);
    state.resizable_split.update_drag(20, 25);
    state.resizable_split.end_drag();
    assert_eq!(state.resizable_split.position(), 20);

    // Act - Reset
    state.resizable_split.reset_position();

    // Assert
    assert_eq!(state.resizable_split.position(), 30);
}

#[test]
fn test_reset_from_maximum_position() {
    // Arrange
    let mut state = AppState::new();

    // Act - Set to maximum
    state.resizable_split.start_drag(30, 25);
    state.resizable_split.update_drag(50, 25);
    state.resizable_split.end_drag();
    assert_eq!(state.resizable_split.position(), 50);

    // Act - Reset
    state.resizable_split.reset_position();

    // Assert
    assert_eq!(state.resizable_split.position(), 30);
}

#[test]
fn test_reset_when_already_at_default() {
    // Arrange
    let mut state = AppState::new();
    assert_eq!(state.resizable_split.position(), 30);

    // Act - Reset when already at default
    state.resizable_split.reset_position();

    // Assert - Should remain at default
    assert_eq!(state.resizable_split.position(), 30);
}
