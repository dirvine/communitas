<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Enable app sandbox -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Keychain access for storing and retrieving passwords -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.saorsalabs.communitas</string>
    </array>

    <!-- Network access for P2P connections -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Allow incoming connections for P2P -->
    <key>com.apple.security.network.incoming-connections</key>
    <true/>

    <!-- File access for local storage -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
