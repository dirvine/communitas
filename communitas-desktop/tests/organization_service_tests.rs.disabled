// Comprehensive tests for Organization CRDT Documents
// Tests cover CRUD operations, four-word identity, CRDT sync, and member management
// Updated to use new CRDT document architecture (backend consolidation)

use anyhow::Result;
use communitas_core::{
    crdt::{CrdtDocument, EntityType, documents::OrganizationDocument},
    crdt_manager::CrdtManager,
    entity_service::{EntityService, MemberInfo},
    identity::generate_id_words,
};
use std::sync::Arc;
use tempfile::TempDir;
use uuid::Uuid;
use yrs::{Doc, ReadTxn, Transact, updates::decoder::Decode, updates::encoder::Encode};

/// Helper to create test CrdtManager with temporary database
async fn create_test_crdt() -> Result<(Arc<CrdtManager>, TempDir)> {
    let temp_dir = tempfile::tempdir()?;
    let db_path = temp_dir.path().join("test.db");
    let crdt = Arc::new(CrdtManager::new(&db_path).await?);
    Ok((crdt, temp_dir))
}

/// Helper to create Organization directly using OrganizationDocument
async fn create_organization(
    crdt: &Arc<CrdtManager>,
    name: &str,
    description: Option<String>,
    created_by: &str,
) -> Result<OrganizationDocument> {
    let id = Uuid::new_v4().to_string();
    let four_word_identity = generate_id_words()?;
    let private_disk_id = format!("private-{}", Uuid::new_v4());
    let public_disk_id = format!("public-{}", Uuid::new_v4());
    let now = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)?
        .as_secs() as i64;

    let org = OrganizationDocument {
        id: id.clone(),
        four_word_identity,
        name: name.to_string(),
        description,
        created_by: created_by.to_string(),
        created_at: now,
        private_disk_id,
        public_disk_id,
        website_root: None,
    };

    // Create and save CRDT document
    let doc = OrganizationDocument::create_document(&id)?;
    org.update_document(&doc)?;

    // Save document using CrdtManager
    let doc_id = org.document_id();
    crdt.save_document(&doc_id, "org", &id, &doc).await?;

    Ok(org)
}

/// Helper to get Organization by ID
async fn get_organization(
    crdt: &Arc<CrdtManager>,
    org_id: &str,
) -> Result<Option<OrganizationDocument>> {
    let doc_id = format!("org:{}", org_id);
    match crdt.load_document(&doc_id).await {
        Ok(doc) => Ok(Some(OrganizationDocument::from_document(&doc)?)),
        Err(_) => Ok(None),
    }
}

/// Helper to update organization
async fn update_organization(
    crdt: &Arc<CrdtManager>,
    org_id: &str,
    name: Option<&str>,
    description: Option<String>,
) -> Result<()> {
    let doc_id = format!("org:{}", org_id);
    let doc = crdt.load_document(&doc_id).await?;

    let mut org = OrganizationDocument::from_document(&doc)?;
    if let Some(new_name) = name {
        org.name = new_name.to_string();
    }
    if let Some(new_desc) = description {
        org.description = Some(new_desc);
    }

    org.update_document(&doc)?;
    crdt.save_document(&doc_id, "org", org_id, &doc).await?;

    Ok(())
}

/// Helper to set website root
async fn set_website_root(crdt: &Arc<CrdtManager>, org_id: &str, website_root: &str) -> Result<()> {
    let doc_id = format!("org:{}", org_id);
    let doc = crdt.load_document(&doc_id).await?;

    let mut org = OrganizationDocument::from_document(&doc)?;
    org.website_root = Some(website_root.to_string());

    org.update_document(&doc)?;
    crdt.save_document(&doc_id, "org", org_id, &doc).await?;

    Ok(())
}

#[tokio::test]
async fn test_create_organization() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let org = create_organization(
        &crdt,
        "Test Organization",
        Some("A test organization".to_string()),
        "user-123",
    )
    .await?;

    // Verify basic fields
    assert!(!org.id.is_empty());
    assert_eq!(org.name, "Test Organization");
    assert_eq!(org.description, Some("A test organization".to_string()));
    assert_eq!(org.created_by, "user-123");

    // Verify four-word identity was generated
    assert!(!org.four_word_identity.is_empty());
    assert!(org.four_word_identity.contains('-')); // Should have dashes

    // Verify disk IDs were generated
    assert!(!org.private_disk_id.is_empty());
    assert!(!org.public_disk_id.is_empty());
    assert_ne!(org.private_disk_id, org.public_disk_id);

    // Verify CRDT doc ID
    let doc_id = org.document_id();
    assert!(doc_id.starts_with("org:"));

    Ok(())
}

#[tokio::test]
async fn test_get_organization() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    // Create organization
    let created = create_organization(&crdt, "Get Test Org", None, "user-123").await?;

    // Retrieve it
    let retrieved = get_organization(&crdt, &created.id).await?;

    assert!(retrieved.is_some());
    let org = retrieved.unwrap();
    assert_eq!(org.id, created.id);
    assert_eq!(org.name, "Get Test Org");
    assert_eq!(org.four_word_identity, created.four_word_identity);

    Ok(())
}

