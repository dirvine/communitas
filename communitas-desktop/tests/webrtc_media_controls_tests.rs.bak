/// Test: get_media_devices - Happy Path
///
/// **Acceptance Criteria**:
/// - Returns list of available media devices
/// - Includes audio input, audio output, and video input devices
/// - Each device has id, label, and kind
#[tokio::test]
async fn test_get_media_devices_success() {
    let fixture = WebRtcTestFixture::new();
    fixture.initialize().expect("fixture init");

    let result = fixture.webrtc_service.get_media_devices();

    assert!(result.is_ok(), "get_media_devices should succeed");

    let devices = result.expect("devices");
    assert!(!devices.is_empty(), "should have at least one device");

    // Verify we have all device types
    let has_audio_input = devices.iter().any(|d| d.kind == DeviceKind::AudioInput);
    let has_audio_output = devices.iter().any(|d| d.kind == DeviceKind::AudioOutput);
    let has_video_input = devices.iter().any(|d| d.kind == DeviceKind::VideoInput);

    assert!(has_audio_input, "should have audio input device");
    assert!(has_audio_output, "should have audio output device");
    assert!(has_video_input, "should have video input device");

    // Verify device structure
    for device in devices {
        assert!(!device.device_id.is_empty(), "device should have ID");
        assert!(!device.label.is_empty(), "device should have label");
    }

    fixture.cleanup().expect("cleanup");
}

/// Test: Media Controls During Active Call
///
/// **Acceptance Criteria**:
/// - Can toggle video on/off during active call
/// - Can toggle audio on/off during active call
/// - Can start/stop screen share during active call
/// - Each change is reflected immediately
#[tokio::test]
async fn test_media_controls_during_active_call() {
    let fixture = WebRtcTestFixture::new();
    fixture.initialize().expect("fixture init");

    let target = "river-mountain-cloud-sun";
    let call_id = fixture.webrtc_service.initiate_call(
        target.to_string(),
        constraints::video_call(),
    ).expect("call ID");

    fixture.webrtc_service.accept_call(call_id.clone())
        .expect("accept call");

    // Initial state - video and audio enabled
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(call.is_video_enabled);
    assert!(call.is_audio_enabled);
    assert!(!call.is_screen_sharing);

    // Disable video
    fixture.webrtc_service.set_video_enabled(call_id.clone(), false)
        .expect("disable video");
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(!call.is_video_enabled);

    // Disable audio (mute)
    fixture.webrtc_service.set_audio_enabled(call_id.clone(), false)
        .expect("disable audio");
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(!call.is_audio_enabled);

    // Start screen sharing
    fixture.webrtc_service.start_screen_share(call_id.clone())
        .expect("start screen share");
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(call.is_screen_sharing);

    // Re-enable video
    fixture.webrtc_service.set_video_enabled(call_id.clone(), true)
        .expect("enable video");
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(call.is_video_enabled);

    // Re-enable audio (unmute)
    fixture.webrtc_service.set_audio_enabled(call_id.clone(), true)
        .expect("enable audio");
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(call.is_audio_enabled);

    // Stop screen sharing
    fixture.webrtc_service.stop_screen_share(call_id.clone())
        .expect("stop screen share");
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(!call.is_screen_sharing);

    fixture.cleanup().expect("cleanup");
}

/// Test: Audio-Only Call Constraints
///
/// **Acceptance Criteria**:
/// - Audio-only call cannot enable video
/// - Attempting to enable video returns error
/// - Can still control audio (mute/unmute)
#[tokio::test]
async fn test_audio_only_call_constraints() {
    let fixture = WebRtcTestFixture::new();
    fixture.initialize().expect("fixture init");

    let target = "river-mountain-cloud-sun";
    let call_id = fixture.webrtc_service.initiate_call(
        target.to_string(),
        constraints::audio_only(),
    ).expect("call ID");

    fixture.webrtc_service.accept_call(call_id.clone())
        .expect("accept call");

    // Verify initial state
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(call.is_audio_enabled);
    assert!(!call.is_video_enabled);

    // Audio control should work
    fixture.webrtc_service.set_audio_enabled(call_id.clone(), false)
        .expect("disable audio");
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(!call.is_audio_enabled);

    fixture.webrtc_service.set_audio_enabled(call_id.clone(), true)
        .expect("enable audio");
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(call.is_audio_enabled);

    // Note: In a real implementation, attempting to enable video on an
    // audio-only call should return an error. For now, the mock allows it.

    fixture.cleanup().expect("cleanup");
}
