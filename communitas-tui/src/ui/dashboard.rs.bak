/// Render network tab content
fn render_network_tab(f: &mut Frame, area: Rect, state: &AppState) {
    let status_indicator = match state.network.status {
        crate::state::ConnectionStatus::Connected => ('●', Color::Green),
        crate::state::ConnectionStatus::Connecting => ('◐', Color::Yellow),
        crate::state::ConnectionStatus::Disconnected => ('○', Color::Gray),
        crate::state::ConnectionStatus::Error(_) => ('✖', Color::Red),
    };

    let title = Paragraph::new(vec![
        Line::from(Span::styled(
            "🌐 Network Status",
            Style::default()
                .fg(Color::Yellow)
                .add_modifier(Modifier::BOLD),
        )),
        Line::from(""),
        Line::from(format!(
            "Status: {} {}",
            status_indicator.0,
            format!("{:?}", state.network.status)
        )),
        Line::from(format!("Peers: {} connected", state.network.peer_count)),
        Line::from(""),
        Line::from(Span::styled(
            "Press 'n' to check network connection",
            Style::default().fg(Color::Green),
        )),
    ])
    .alignment(Alignment::Center);

    f.render_widget(title, area);
}

/// Render help tab content
fn render_help_tab(f: &mut Frame, area: Rect, _state: &AppState) {
    let help_content = Paragraph::new(vec![
        Line::from(Span::styled(
            "❓ Help & Shortcuts",
            Style::default()
                .fg(Color::Yellow)
                .add_modifier(Modifier::BOLD),
        )),
        Line::from(""),
        Line::from("Navigation:"),
        Line::from("  h/l or ←→ : Switch between tabs"),
        Line::from("  k/j or ↑↓ : Navigate within lists"),
        Line::from(""),
        Line::from("Actions:"),
        Line::from("  Enter : Select/Confirm"),
        Line::from("  n     : Create new entity"),
        Line::from("  i     : Initialize identity"),
        Line::from("  q     : Quit"),
        Line::from(""),
        Line::from("Mouse:"),
        Line::from("  Click : Select item/tab"),
        Line::from("  Right : Context menu"),
        Line::from("  Scroll : Navigate lists"),
    ])
    .alignment(Alignment::Left);

    f.render_widget(help_content, area);
}

/// Render empty tab placeholder
fn render_empty_tab(f: &mut Frame, area: Rect, message: &str) {
    let placeholder = Paragraph::new(vec![
        Line::from(""),
        Line::from(Span::styled(message, Style::default().fg(Color::Gray))),
        Line::from(""),
    ])
    .alignment(Alignment::Center);

    f.render_widget(placeholder, area);
}

/// Render left panel with navigation/tree view
fn render_left_panel(f: &mut Frame, area: Rect, state: &AppState) {
    // Create block for left panel
    let block = Block::default()
        .title(Span::styled(
            " Navigation ",
            Style::default()
                .fg(Color::Cyan)
                .add_modifier(Modifier::BOLD),
        ))
        .borders(Borders::ALL)
        .border_style(Style::default().fg(Color::DarkGray));

    let inner = block.inner(area);
    f.render_widget(block, area);

    // Render TreeView
    let lines = render_tree_view(state);
    let content = Paragraph::new(lines).alignment(Alignment::Left);
    f.render_widget(content, inner);
}

/// Render TreeView nodes as lines
fn render_tree_view(state: &AppState) -> Vec<Line<'static>> {
    let mut lines = Vec::new();

    // Add empty line for padding
    lines.push(Line::from(""));

    // Recursively render tree nodes
    render_tree_node(state.tree_view.root(), &state.tree_view, 0, &mut lines, state.tree_view.selected());

    // Add help text at bottom
    lines.push(Line::from(""));
    lines.push(Line::from(Span::styled(
        "Press Ctrl+K for commands",
        Style::default().fg(Color::DarkGray),
    )));

    lines
}

/// Recursively render tree nodes with indentation
fn render_tree_node(
    node: &crate::components::TreeNode<String>,
    tree_view: &crate::components::TreeView<String>,
    depth: usize,
    lines: &mut Vec<Line<'static>>,
    selected: Option<&str>,
) {
    

    // Create indentation
    let indent = "  ".repeat(depth);

    // Determine if this node is selected
    let is_selected = selected == Some(&node.id);

    // Choose style based on selection
    let style = if is_selected {
        Style::default()
            .fg(Color::Black)
            .bg(Color::Cyan)
            .add_modifier(Modifier::BOLD)
    } else {
        Style::default().fg(Color::White)
    };

    // Determine expand/collapse indicator
    let indicator = if node.has_children() {
        if tree_view.is_expanded(&node.id) {
            "▼ "
        } else {
            "▶ "
        }
    } else {
        "  "
    };

    // Get icon (if any)
    let icon = node.icon.map(|c| format!("{} ", c)).unwrap_or_default();

    // Build the line
    let line_text = format!("{}{}{}{}", indent, indicator, icon, node.label);
    lines.push(Line::from(Span::styled(line_text, style)));

    // Render children if expanded
    if tree_view.is_expanded(&node.id) {
        for child in &node.children {
            render_tree_node(child, tree_view, depth + 1, lines, selected);
        }
    }
}

/// Populate TreeView from entity data
    #[allow(dead_code)]
pub fn populate_tree_from_entities(state: &mut AppState) {
    use crate::components::TreeNode;

    // Save current expansion states
    let mut expanded_nodes = std::collections::HashSet::new();
    collect_expanded_nodes(state.tree_view.root(), &state.tree_view, &mut expanded_nodes);

    // Build new tree structure
    let mut root = TreeNode::new("root", "Entities", String::new());

    // Add organizations (channels are stored by org_id in HashMap)
    for (org_id, channels) in &state.entities.channels {
        // Use org_id as organization name (simplified - could be improved)
        let org_name = if channels.is_empty() {
            org_id.clone()
        } else {
            // Use first channel's context for org info (simplified)
            org_id.clone()
        };

        let mut org_node = TreeNode::new(
            org_id,
            &org_name,
            org_id.clone(),
        )
        .with_icon('🏢');

        // Add channels under this organization
        for channel in channels {
            let channel_node = TreeNode::new(
                &channel.id,
                &channel.name,
                channel.id.clone(),
            )
            .with_icon('💬'); // Use chat icon for channels

            org_node = org_node.with_child(channel_node);
        }

        root = root.with_child(org_node);
    }

    // Add projects as top-level nodes (they can be moved under orgs later)
    for project in &state.entities.projects {
        let project_node = TreeNode::new(
            &project.id,
            &project.name,
            project.id.clone(),
        )
        .with_icon('📋');

        root = root.with_child(project_node);
    }

    // Add groups as top-level nodes
    for group in &state.entities.groups {
        let group_node = TreeNode::new(
            &group.id,
            &group.name,
            group.id.clone(),
        )
        .with_icon('👥');

        root = root.with_child(group_node);
    }

    // Add contacts as top-level nodes
    for contact in &state.entities.contacts {
        let contact_node = TreeNode::new(
            &contact.id,
            &contact.display_name, // ContactData uses display_name
            contact.id.clone(),
        )
        .with_icon('👤');

        root = root.with_child(contact_node);
    }

    // Recreate TreeView with new root
    state.tree_view = crate::components::TreeView::new(root);

    // Restore expansion states
    restore_expanded_nodes(&mut state.tree_view, &expanded_nodes);
}

#[allow(dead_code)]
/// Collect IDs of currently expanded nodes
fn collect_expanded_nodes(
    node: &crate::components::TreeNode<String>,
    tree_view: &crate::components::TreeView<String>,
    expanded: &mut std::collections::HashSet<String>,
) {
    if tree_view.is_expanded(&node.id) {
        expanded.insert(node.id.clone());

        for child in &node.children {
            collect_expanded_nodes(child, tree_view, expanded);
        }
    }
}
#[allow(dead_code)]

/// Restore expansion state for previously expanded nodes
fn restore_expanded_nodes(
    tree_view: &mut crate::components::TreeView<String>,
    expanded: &std::collections::HashSet<String>,
) {
    // Collect all node IDs in the tree first (to avoid borrow issues)
    let mut all_node_ids = Vec::new();
    collect_all_node_ids(tree_view.root(), &mut all_node_ids);

    // Now expand the nodes that were previously expanded
    for node_id in all_node_ids {
        if expanded.contains(&node_id) {
            tree_view.expand_node(&node_id);
        }
    }
#[allow(dead_code)]
}

/// Collect all node IDs in the tree
fn collect_all_node_ids(
    node: &crate::components::TreeNode<String>,
    ids: &mut Vec<String>,
) {
    ids.push(node.id.clone());
    for child in &node.children {
        collect_all_node_ids(child, ids);
    }
}

/// Render resizable divider between left and right panels
fn render_divider(f: &mut Frame, area: Rect, _state: &AppState) {
    // TODO: Add hover state styling from state.resizable_split
    // For now, render simple divider
    let divider_style = Style::default()
        .fg(Color::DarkGray)
        .bg(Color::Reset);

    // Fill divider area with vertical bar character
    let _divider = Paragraph::new(vec![Line::from("│".to_string())])
        .style(divider_style);

    // Render the divider for each row
    for y in 0..area.height {
        let cell_area = Rect::new(area.x, area.y + y, 1, 1);
        f.render_widget(
            Paragraph::new("│").style(divider_style),
            cell_area,
        );
    }
}
