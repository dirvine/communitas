{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Communitas",
  "version": "0.1.1",
  "identifier": "com.p2pfoundation.communitas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5001/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Communitas - Privacy, Security and Freedom (Saorsa)",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "bin/*",
          "cmd": "bin/*",
          "args": true
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://github.com/dirvine/communitas/releases/latest/download/latest.json"
      ]
    }
  }
}