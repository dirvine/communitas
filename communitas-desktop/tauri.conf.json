{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Communitas",
  "version": "0.1.17",
  "identifier": "com.saorsalabs.communitas",
  "build": {
    "beforeDevCommand": "npm run build && npm run dev:frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Communitas - Privacy, Security and Freedom (Saorsa)",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main window capabilities",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:allow-ask",
            "dialog:allow-message",
            "dialog:allow-confirm",
            "dialog:allow-open",
            "dialog:allow-save"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Communitas.entitlements",
      "exceptionDomain": null,
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "$TAURI_MACOS_SIGNING_IDENTITY"
    },
    "windows": {
      "certificateThumbprint": "$TAURI_WINDOWS_CERTIFICATE_THUMBPRINT",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "bin/*",
          "cmd": "bin/*",
          "args": true
        }
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/dirvine/communitas/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "$TAURI_UPDATER_PUBKEY"
    }
  }
}