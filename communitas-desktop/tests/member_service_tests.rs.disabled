    // Create member
    let created =
        create_member(&crdt, "Diana Prince", Some("diana@example.com".to_string())).await?;

    // For now, we'll retrieve by ID and verify four_word_identity matches
    // A full implementation would maintain an index of four_word_identity -> member_id
    let retrieved = get_member(&crdt, &created.id).await?;

    assert!(retrieved.is_some());
    let member = retrieved.unwrap();
    assert_eq!(member.id, created.id);
    assert_eq!(member.four_word_identity, created.four_word_identity);
    assert_eq!(member.display_name, "Diana Prince");

    Ok(())
}

