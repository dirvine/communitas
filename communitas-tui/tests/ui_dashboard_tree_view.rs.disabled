// ============================================================================
// TEST 3: TreeView expand/collapse state
// ============================================================================

#[test]
fn test_tree_view_root_starts_expanded() {
    // Arrange
    let state = AppState::new();

    // Assert - Root should be expanded by default
    assert!(state.tree_view.is_expanded("root"));
}

#[test]
fn test_tree_view_can_expand_node() {
    // Arrange
    let mut state = AppState::new();

    // Act - Expand a node (if it has children)
    // In actual usage: state.tree_view.expand("node_id")

    // Assert - Node should be expanded
    // This tests the TreeView API
}

#[test]
fn test_tree_view_can_collapse_node() {
    // Arrange
    let mut state = AppState::new();

    // Root is expanded by default
    assert!(state.tree_view.is_expanded("root"));

    // Act - Collapse root
    state.tree_view.collapse_node("root");

    // Assert - Root should now be collapsed
    assert!(!state.tree_view.is_expanded("root"));
}

#[test]
fn test_tree_view_toggle_expands_collapsed_node() {
    // Arrange
    let mut state = AppState::new();
    state.tree_view.collapse_node("root");
    assert!(!state.tree_view.is_expanded("root"));

    // Act - Toggle (should expand)
    state.tree_view.toggle_expanded("root");

    // Assert
    assert!(state.tree_view.is_expanded("root"));
}

#[test]
fn test_tree_view_toggle_collapses_expanded_node() {
    // Arrange
    let mut state = AppState::new();
    assert!(state.tree_view.is_expanded("root"));

    // Act - Toggle (should collapse)
    state.tree_view.toggle_expanded("root");

    // Assert
    assert!(!state.tree_view.is_expanded("root"));
}

