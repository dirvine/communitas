//! WebRTC Media Controls Tests (TDD Red Phase)
//!
//! These tests define the expected behavior for media control commands
//! (video, audio, screen sharing). They will fail until implementation.

mod fixtures;

use fixtures::webrtc_fixtures::{
    constraints, test_identity, DeviceKind, WebRtcTestFixture,
};

/// Test: set_video_enabled - Enable Video
///
/// **Acceptance Criteria**:
/// - Video track is enabled in the call
/// - VideoEnabled event is emitted
/// - Peer is notified via signaling
#[tokio::test]
async fn test_set_video_enabled_on() {
    let fixture = WebRtcTestFixture::new();
    fixture.initialize().expect("fixture init");

    // Create an active call with video
    let target = "river-mountain-cloud-sun";
    let call_id = fixture.webrtc_service.initiate_call(
        target.to_string(),
        constraints::video_call(),
    ).expect("call ID");

    fixture.webrtc_service.accept_call(call_id.clone())
        .expect("accept call");

    // Disable video first
    fixture.webrtc_service.set_video_enabled(call_id.clone(), false)
        .expect("disable video");

    // Re-enable video
    let result = fixture.webrtc_service.set_video_enabled(call_id.clone(), true);

    assert!(result.is_ok(), "set_video_enabled should succeed");

    // Verify video is enabled
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(call.is_video_enabled, "video should be enabled");

    fixture.cleanup().expect("cleanup");
}

/// Test: set_video_enabled - Disable Video
///
/// **Acceptance Criteria**:
/// - Video track is disabled in the call
/// - VideoDisabled event is emitted
/// - Peer is notified via signaling
#[tokio::test]
async fn test_set_video_enabled_off() {
    let fixture = WebRtcTestFixture::new();
    fixture.initialize().expect("fixture init");

    let target = "river-mountain-cloud-sun";
    let call_id = fixture.webrtc_service.initiate_call(
        target.to_string(),
        constraints::video_call(),
    ).expect("call ID");

    fixture.webrtc_service.accept_call(call_id.clone())
        .expect("accept call");

    // Disable video
    let result = fixture.webrtc_service.set_video_enabled(call_id.clone(), false);

    assert!(result.is_ok(), "set_video_enabled should succeed");

    // Verify video is disabled
    let call = fixture.webrtc_service.get_call(&call_id).expect("call");
    assert!(!call.is_video_enabled, "video should be disabled");

    fixture.cleanup().expect("cleanup");
}

/// Test: set_video_enabled - Invalid Call ID
///
/// **Acceptance Criteria**:
/// - Returns error for non-existent call
/// - Error message indicates call not found
#[tokio::test]
async fn test_set_video_enabled_invalid_call() {
    let fixture = WebRtcTestFixture::new();
    fixture.initialize().expect("fixture init");

    let invalid_id = "call_nonexistent";

    let result = fixture.webrtc_service.set_video_enabled(
        invalid_id.to_string(),
        true,
    );

    assert!(result.is_err(), "should fail with invalid call ID");
    let error = result.expect_err("error");
    assert!(
        error.contains("not found") || error.contains("Call not found"),
        "error should mention call not found"
    );

    fixture.cleanup().expect("cleanup");
}

