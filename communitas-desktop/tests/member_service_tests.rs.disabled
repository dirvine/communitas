// Comprehensive tests for Member CRDT Documents
// Tests cover CRUD operations, four-word identity, personal disks, and CRDT sync
// Updated to use new CRDT document architecture (backend consolidation)

use anyhow::Result;
use communitas_core::{
    crdt::{CrdtDocument, documents::MemberDocument},
    crdt_manager::CrdtManager,
    identity::generate_id_words,
};
use std::sync::Arc;
use tempfile::TempDir;
use uuid::Uuid;
use yrs::{Doc, ReadTxn, Transact, updates::decoder::Decode, updates::encoder::Encode};

/// Helper to create test CrdtManager with temporary database
async fn create_test_crdt() -> Result<(Arc<CrdtManager>, TempDir)> {
    let temp_dir = tempfile::tempdir()?;
    let db_path = temp_dir.path().join("test.db");
    let crdt = Arc::new(CrdtManager::new(&db_path).await?);
    Ok((crdt, temp_dir))
}

/// Helper to create Member directly using MemberDocument
async fn create_member(
    crdt: &Arc<CrdtManager>,
    display_name: &str,
    email: Option<String>,
) -> Result<MemberDocument> {
    let id = Uuid::new_v4().to_string();
    let four_word_identity = generate_id_words()?;
    let personal_disk_id = format!("disk-{}", Uuid::new_v4());
    let now = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)?
        .as_secs() as i64;

    let member = MemberDocument {
        id: id.clone(),
        four_word_identity,
        display_name: display_name.to_string(),
        email,
        bio: None,
        avatar_url: None,
        created_at: now,
        personal_disk_id,
        website_root: None,
    };

    // Create and save CRDT document
    let doc = MemberDocument::create_document(&id)?;
    member.update_document(&doc)?;

    // Save document using CrdtManager
    let doc_id = member.document_id();
    crdt.save_document(&doc_id, "member", &id, &doc).await?;

    Ok(member)
}

/// Helper to get Member by ID
async fn get_member(crdt: &Arc<CrdtManager>, member_id: &str) -> Result<Option<MemberDocument>> {
    let doc_id = format!("member:{}", member_id);
    match crdt.load_document(&doc_id).await {
        Ok(doc) => Ok(Some(MemberDocument::from_document(&doc)?)),
        Err(_) => Ok(None),
    }
}

/// Helper to update member
async fn update_member(
    crdt: &Arc<CrdtManager>,
    member_id: &str,
    display_name: Option<&str>,
    email: Option<String>,
    avatar_url: Option<String>,
    bio: Option<String>,
) -> Result<()> {
    let doc_id = format!("member:{}", member_id);
    let doc = crdt.load_document(&doc_id).await?;

    let mut member = MemberDocument::from_document(&doc)?;
    if let Some(new_name) = display_name {
        member.display_name = new_name.to_string();
    }
    if let Some(new_email) = email {
        member.email = Some(new_email);
    }
    if let Some(new_avatar) = avatar_url {
        member.avatar_url = Some(new_avatar);
    }
    if let Some(new_bio) = bio {
        member.bio = Some(new_bio);
    }

    member.update_document(&doc)?;
    crdt.save_document(&doc_id, "member", member_id, &doc)
        .await?;

    Ok(())
}

/// Helper to set website root
async fn set_website_root(
    crdt: &Arc<CrdtManager>,
    member_id: &str,
    website_root: &str,
) -> Result<()> {
    let doc_id = format!("member:{}", member_id);
    let doc = crdt.load_document(&doc_id).await?;

    let mut member = MemberDocument::from_document(&doc)?;
    member.website_root = Some(website_root.to_string());

    member.update_document(&doc)?;
    crdt.save_document(&doc_id, "member", member_id, &doc)
        .await?;

    Ok(())
}

#[tokio::test]
async fn test_create_member() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(
        &crdt,
        "Alice Johnson",
        Some("alice@example.com".to_string()),
    )
    .await?;

    // Verify basic fields
    assert!(!member.id.is_empty());
    assert_eq!(member.display_name, "Alice Johnson");
    assert_eq!(member.email, Some("alice@example.com".to_string()));

    // Verify four-word identity was generated
    assert!(!member.four_word_identity.is_empty());
    assert!(member.four_word_identity.contains('-')); // Should have dashes

    // Verify personal disk was created
    assert!(!member.personal_disk_id.is_empty());

    // Verify CRDT doc ID
    let doc_id = member.document_id();
    assert!(doc_id.starts_with("member:"));

    // Initially no avatar, bio, or website root
    assert!(member.avatar_url.is_none());
    assert!(member.bio.is_none());
    assert!(member.website_root.is_none());

    Ok(())
}

#[tokio::test]
async fn test_create_member_without_email() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let member = create_member(&crdt, "Bob Smith", None).await?;

    assert_eq!(member.display_name, "Bob Smith");
    assert!(member.email.is_none());
    assert!(!member.four_word_identity.is_empty());
    assert!(!member.personal_disk_id.is_empty());

    Ok(())
}

#[tokio::test]
async fn test_get_member() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    // Create member
    let created = create_member(
        &crdt,
        "Charlie Brown",
        Some("charlie@example.com".to_string()),
    )
    .await?;

    // Retrieve it
    let retrieved = get_member(&crdt, &created.id).await?;

    assert!(retrieved.is_some());
    let member = retrieved.unwrap();
    assert_eq!(member.id, created.id);
    assert_eq!(member.display_name, "Charlie Brown");
    assert_eq!(member.four_word_identity, created.four_word_identity);
    assert_eq!(member.email, Some("charlie@example.com".to_string()));

    Ok(())
}

