#[tokio::test]
async fn test_update_organization() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    // Create organization
    let org = create_organization(
        &crdt,
        "Original Name",
        Some("Original desc".to_string()),
        "user-123",
    )
    .await?;

    // Update name
    update_organization(&crdt, &org.id, Some("Updated Name"), None).await?;

    let updated = get_organization(&crdt, &org.id).await?.unwrap();
    assert_eq!(updated.name, "Updated Name");
    assert_eq!(updated.description, Some("Original desc".to_string()));

    // Update description
    update_organization(
        &crdt,
        &org.id,
        None,
        Some("Updated description".to_string()),
    )
    .await?;

    let updated2 = get_organization(&crdt, &org.id).await?.unwrap();
    assert_eq!(updated2.name, "Updated Name");
    assert_eq!(
        updated2.description,
        Some("Updated description".to_string())
    );

    Ok(())
}

#[tokio::test]
async fn test_set_website_root() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let org = create_organization(&crdt, "Website Test Org", None, "user-123").await?;

    // Initially no website root
    let initial = get_organization(&crdt, &org.id).await?.unwrap();
    assert!(initial.website_root.is_none());

    // Set website root
    let root_hash = "QmHash123456789";
    set_website_root(&crdt, &org.id, root_hash).await?;

    // Verify it was set
    let updated = get_organization(&crdt, &org.id).await?.unwrap();
    assert_eq!(updated.website_root, Some(root_hash.to_string()));

    Ok(())
}

// Member management tests now use EntityService (the new member management layer)

#[tokio::test]
async fn test_add_member() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;
    let entity_service = EntityService::new(crdt.clone());

    let org = create_organization(&crdt, "Member Test Org", None, "user-123").await?;

    // Add creator as initial member
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-123", "owner")
        .await?;

    // Add member with admin role
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-456", "admin")
        .await?;

    // Verify members were added
    let members = entity_service
        .list_members(EntityType::Organisation, &org.id)
        .await?;

    let active_members: Vec<&MemberInfo> = members.iter().filter(|m| !m.deleted).collect();
    assert_eq!(active_members.len(), 2);

    let added_member = members.iter().find(|m| m.member_id == "user-456").unwrap();
    assert_eq!(added_member.role, "admin");

    // Add second member
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-789", "member")
        .await?;

    let members2 = entity_service
        .list_members(EntityType::Organisation, &org.id)
        .await?;
    let active_members2: Vec<&MemberInfo> = members2.iter().filter(|m| !m.deleted).collect();
    assert_eq!(active_members2.len(), 3);

    Ok(())
}

#[tokio::test]
async fn test_remove_member() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;
    let entity_service = EntityService::new(crdt.clone());

    let org = create_organization(&crdt, "Remove Member Test", None, "user-123").await?;

    // Add members
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-123", "owner")
        .await?;
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-456", "admin")
        .await?;
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-789", "member")
        .await?;

    let members = entity_service
        .list_members(EntityType::Organisation, &org.id)
        .await?;
    let active = members.iter().filter(|m| !m.deleted).count();
    assert_eq!(active, 3);

    // Remove one member
    entity_service
        .remove_member(EntityType::Organisation, &org.id, "user-456", "user-123")
        .await?;

    let members_after = entity_service
        .list_members(EntityType::Organisation, &org.id)
        .await?;
    let active_after = members_after.iter().filter(|m| !m.deleted).count();
    assert_eq!(active_after, 2);

    // Verify user-789 is still there and active
    let user_789 = members_after
        .iter()
        .find(|m| m.member_id == "user-789")
        .unwrap();
    assert!(!user_789.deleted);

    Ok(())
}

#[tokio::test]
async fn test_update_member_role() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;
    let entity_service = EntityService::new(crdt.clone());

    let org = create_organization(&crdt, "Role Update Test", None, "user-123").await?;

    // Add members
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-123", "owner")
        .await?;
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-456", "member")
        .await?;

    // To update role, we need to remove and re-add
    // This is the CRDT way - tombstone old membership, add new one
    entity_service
        .remove_member(EntityType::Organisation, &org.id, "user-456", "user-123")
        .await?;
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-456", "admin")
        .await?;

    let members = entity_service
        .list_members(EntityType::Organisation, &org.id)
        .await?;

    // Find the active membership for user-456 (there will be a deleted one and an active one)
    let updated_member = members
        .iter()
        .filter(|m| m.member_id == "user-456" && !m.deleted)
        .next()
        .unwrap();
    assert_eq!(updated_member.role, "admin");

    Ok(())
}

#[tokio::test]
async fn test_is_member() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;
    let entity_service = EntityService::new(crdt.clone());

    let org = create_organization(&crdt, "Membership Test", None, "user-123").await?;

    // Check if user-456 is member
    let members_before = entity_service
        .list_members(EntityType::Organisation, &org.id)
        .await?;
    let is_member_before = members_before
        .iter()
        .any(|m| m.member_id == "user-456" && !m.deleted);
    assert!(!is_member_before);

    // Add member
    entity_service
        .add_member(EntityType::Organisation, &org.id, "user-456", "member")
        .await?;

    // Now is a member
    let members_after = entity_service
        .list_members(EntityType::Organisation, &org.id)
        .await?;
    let is_member_after = members_after
        .iter()
        .any(|m| m.member_id == "user-456" && !m.deleted);
    assert!(is_member_after);

    Ok(())
}

#[tokio::test]
async fn test_list_user_organizations() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;
    let entity_service = EntityService::new(crdt.clone());

    let user_id = "user-123";

    // Create organizations
    let org1 = create_organization(&crdt, "Org 1", None, "creator-1").await?;
    let org2 = create_organization(&crdt, "Org 2", None, "creator-2").await?;

    // Add user as member to both
    entity_service
        .add_member(EntityType::Organisation, &org1.id, user_id, "member")
        .await?;
    entity_service
        .add_member(EntityType::Organisation, &org2.id, user_id, "admin")
        .await?;

    // For now, we need to manually check each org
    // A full implementation would maintain a user->orgs index
    let org1_members = entity_service
        .list_members(EntityType::Organisation, &org1.id)
        .await?;
    let org2_members = entity_service
        .list_members(EntityType::Organisation, &org2.id)
        .await?;

    assert!(
        org1_members
            .iter()
            .any(|m| m.member_id == user_id && !m.deleted)
    );
    assert!(
        org2_members
            .iter()
            .any(|m| m.member_id == user_id && !m.deleted)
    );

    Ok(())
}

#[tokio::test]
async fn test_delete_organization() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let org = create_organization(&crdt, "Delete Test", None, "user-123").await?;

    // Verify it exists
    assert!(get_organization(&crdt, &org.id).await?.is_some());

    // Delete it by removing from database
    let doc_id = format!("org:{}", org.id);
    crdt.delete_document(&doc_id).await?;

    // Verify it's gone
    assert!(get_organization(&crdt, &org.id).await?.is_none());

    Ok(())
}

#[tokio::test]
async fn test_crdt_update_sync() -> Result<()> {
    let (crdt, _temp) = create_test_crdt().await?;

    let org = create_organization(&crdt, "CRDT Test", None, "user-123").await?;

    // Get full update
    let doc_id = format!("org:{}", org.id);
    let doc = crdt.load_document(&doc_id).await?;
    let update = doc
        .transact()
        .encode_state_as_update_v1(&yrs::StateVector::default());
    assert!(!update.is_empty());

    // Apply update (simulating sync from another peer)
    let doc2 = Doc::new();
    {
        let mut txn = doc2.transact_mut();
        txn.apply_update(yrs::Update::decode_v1(&update)?);
    }

    // Should still work
    let retrieved = OrganizationDocument::from_document(&doc2)?;
    assert_eq!(retrieved.id, org.id);
    assert_eq!(retrieved.name, org.name);

    Ok(())
}

